---
// @ts-check
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://labs.walerys.app');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="labs.walerys.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="labs.walerys.app"
      href={new URL('rss.xml', site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Keep the explicit choice within this tab; a fresh session starts dark.
      (function () {
        try {
          document.documentElement.dataset.theme =
            sessionStorage.getItem('theme') === 'light' ? 'light' : 'dark';
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site">
        <a class="brand" href="/">labs.walerys.app</a>
        <nav aria-label="Main navigation">
          <a href="/">labs</a>
          <a href="/about/">about</a>
          <a href="https://www.linkedin.com/in/leszekwalerys/" rel="me noopener">linkedin</a>
          <button class="theme-toggle" id="theme-toggle" type="button"
            aria-label="Light theme" aria-pressed="false" hidden>
            <span id="theme-icon" aria-hidden="true"></span>
          </button>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site">
        <p>
          <span class="dot">*</span> The heart mumbles, the mouse scratches. A static
          notebook of experiments — built once, served always.
          <a href="/about/#the-name">Why labs?</a>
        </p>
      </footer>
    </div>
    <script>
      // Small, deliberate JavaScript: theme switch without a framework runtime.
      const button = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const icon = document.getElementById('theme-icon');
      const set = (t: 'dark' | 'light') => {
        root.dataset.theme = t;
        button?.setAttribute('aria-pressed', String(t === 'light'));
        try {
          sessionStorage.setItem('theme', t);
        } catch {}
        if (icon) icon.textContent = t === 'dark' ? '☀' : '☾';
      };
      set(root.dataset.theme === 'light' ? 'light' : 'dark');
      if (button) button.hidden = false;
      button?.addEventListener('click', () => {
        set(root.dataset.theme === 'light' ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
