---
// @ts-check
import { createHash } from 'node:crypto';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  profile?: boolean;
  article?: {
    publishedTime: string;
    tags: string[];
    image?: { url: string; alt: string; width: number; height: number };
  };
}

const { title, description, noindex = false, profile = false, article } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const authorURL = new URL('/about/', site).href;
const person = {
  '@type': 'Person',
  '@id': `${authorURL}#person`,
  name: 'Leszek Walerys',
  url: authorURL,
  sameAs: ['https://www.linkedin.com/in/leszekwalerys/'],
};
const shareImage = article?.image ?? {
  url: '/social/labs.png',
  alt: 'Labs — Software, hardware, and better ways of working. labs.walerys.app.',
  width: 1200,
  height: 630,
};
const shareImageURL = new URL(shareImage.url, site).href;
const structuredData = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  datePublished: article.publishedTime,
  author: person,
  inLanguage: 'en',
  ...(article.tags.length > 0 && { keywords: article.tags }),
  // A site-brand card is not a representative article illustration.
  ...(article.image && { image: shareImageURL }),
} : profile ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  mainEntity: person,
} : undefined;
// Escape '<' so editorial text cannot terminate the JSON script element.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, '\\u003c');
const themeInit = `try {
  document.documentElement.dataset.theme =
    sessionStorage.getItem('theme') === 'light' ? 'light' : 'dark';
} catch {}`;
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeInit).digest('base64')}`);
if (jsonLd) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(jsonLd).digest('base64')}`);
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Leszek Walerys" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={article ? 'article' : profile ? 'profile' : 'website'} />
    <meta property="og:site_name" content="labs.walerys.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageURL} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:author" content={authorURL} />
        {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="author" href={authorURL} />
    <link rel="sitemap" href={new URL('/sitemap-index.xml', site)} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="labs.walerys.app"
      href={new URL('rss.xml', site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site">
        <a class="brand" href="/">labs.walerys.app</a>
        <nav aria-label="Main navigation">
          <a href="/">labs</a>
          <a href="/about/">about</a>
          <a href="https://www.linkedin.com/in/leszekwalerys/" rel="me noopener">linkedin</a>
          <button class="theme-toggle" id="theme-toggle" type="button"
            aria-label="Switch to light theme" hidden>
            <span id="theme-icon" aria-hidden="true">light</span>
          </button>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site">
        <p>Leszek Walerys</p>
        <nav aria-label="Footer">
          <a href="/rss.xml">rss</a>
          <a href="/about/">about</a>
          <a href="/privacy/">privacy</a>
        </nav>
      </footer>
    </div>
    <script>
      // Small, deliberate JavaScript: theme switch without a framework runtime.
      const button = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const icon = document.getElementById('theme-icon');
      const set = (t: 'dark' | 'light') => {
        root.dataset.theme = t;
        const nextTheme = t === 'dark' ? 'light' : 'dark';
        button?.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
        button?.setAttribute('title', `Switch to ${nextTheme} theme`);
        if (icon) icon.textContent = nextTheme;
      };
      set(root.dataset.theme === 'light' ? 'light' : 'dark');
      if (button) button.hidden = false;
      button?.addEventListener('click', () => {
        set(root.dataset.theme === 'light' ? 'dark' : 'light');
        try {
          sessionStorage.setItem('theme', root.dataset.theme!);
        } catch {}
      });
    </script>
  </body>
</html>
