---
// @ts-check
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { isoDate } from '../lib/format';
import { sortedPosts, PAGE_SIZE } from '../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await sortedPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'posts'>>;
}

const { page } = Astro.props;
---

<Base
  title={page.currentPage > 1 ? `Labs — page ${page.currentPage}` : 'Labs'}
  description="A personal laboratory for software, automation, and better ways of working. Experiments, lessons, and things worth understanding."
>
  <h1>Labs</h1>
  <p class="archive-intro">A personal laboratory for software, automation, and better ways of working. Experiments, lessons, and things worth understanding.</p>
  {page.lastPage > 1 && <p class="muted">Page {page.currentPage} of {page.lastPage}</p>}

  {page.data.map((post) => (
    <article class="post">
      <div class="post-title-row">
        <div class="post-title-group">
          <p class="post-meta muted">
            <time datetime={post.data.pubDate.toISOString()}>{isoDate(post.data.pubDate)}</time>
            <span>{post.data.readingMinutes} min read</span>
          </p>
          <h2><a href={`/${post.data.slug}/`}>{post.data.title}</a></h2>
        </div>
        {post.data.thumbnail && (
          <Image
            class="post-thumbnail"
            src={post.data.thumbnail.src}
            alt={post.data.thumbnail.alt}
            width={176}
          />
        )}
      </div>
      <p class="excerpt">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </article>
  ))}

  {page.data.length === 0 && <p class="muted">Nothing here yet. The first experiment is on its way.</p>}

  {(page.url.prev || page.url.next) && (
    <nav class="pager" aria-label="Archive pages">
      <span>
        {page.url.prev && <a href={page.url.prev} rel="prev">← newer</a>}
      </span>
      <span>
        {page.url.next && <a href={page.url.next} rel="next">older →</a>}
      </span>
    </nav>
  )}
</Base>
